{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": [
      "es2020"
    ],
    "noEmit": true,
    "strict": true,
    "target": "es6",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "jest"
    ],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "src/*": [
        "src/*"
      ],
      "config/*": [
        "config/*"
      ],
      "data/*": [
        "data/*"
      ],
      "utils/*": [
        "src/utils/*"
      ],
      "gameLogic/*": [
        "src/gameLogic/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "node_modules/@node-sc2/core/**/*",
    "data/buildOrders/**/*",
    "data/gameData/**/*",
    "data/mapResources/mapResources.js",
    "tests/**/*"
  ],
  "exclude": [
    "src/old"
  ]
}